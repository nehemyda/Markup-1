{
  "name": "vpin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "firebase:emulators": "JAVA_TOOL_OPTIONS=-Xmx4g firebase emulators:start --config scripts/firebase-legacy/firebase.json --project demo-markup --export-on-exit=./emulator-data $([ -f emulator-data/firebase-export-metadata.json ] && echo --import=./emulator-data)",
    "migrate:export": "tsx scripts/firebase-legacy/export.ts",
    "migrate:import": "tsx scripts/import-to-supabase.ts",
    "test:db": "node supabase/tests/policies.test.mjs",
    "wp:test": "npx -y @wp-playground/cli@3.1.54 server --port=8881 --php=8.3 --workers=1 --mount-before-install=../wordpress-test-site:/wordpress --wordpress-install-mode=install-from-existing-files-if-needed --mount=./wordpress-plugin/webreview-connector:/wordpress/wp-content/plugins/webreview-connector --mount=./wordpress-plugin/dev:/webreview-dev --blueprint=./wordpress-plugin/dev/blueprint.json --define WP_ENVIRONMENT_TYPE local --login",
    "wp:zip": "mkdir -p build && rm -f build/vpin-connector.zip && cd wordpress-plugin && zip -rq ../build/vpin-connector.zip webreview-connector -x '*.DS_Store'",
    "ext:zip": "mkdir -p build && rm -f build/vpin-chrome-extension.zip && cd chrome-extension && zip -rq ../build/vpin-chrome-extension.zip . -x '*.DS_Store' 'icons/icon.svg' 'README.md'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "aws4fetch": "1.0.20",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^7.0.13",
    "puppeteer-core": "^25.14.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "undici": "7.30.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/workers-types": "5.20261015.1",
    "@electric-sql/pglite": "^0.3.15",
    "@playwright/test": "1.64.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-admin": "^13.10.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "4.151.0"
  }
}
