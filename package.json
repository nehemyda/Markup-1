{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "emulators": "firebase emulators:start --project demo-markup --export-on-exit=./emulator-data $([ -f emulator-data/firebase-export-metadata.json ] && echo --import=./emulator-data)",
    "wp:test": "npx -y @wp-playground/cli@3.1.54 server --port=8881 --php=8.3 --workers=1 --mount-before-install=../wordpress-test-site:/wordpress --wordpress-install-mode=install-from-existing-files-if-needed --mount=./wordpress-plugin/webreview-connector:/wordpress/wp-content/plugins/webreview-connector --mount=./wordpress-plugin/dev:/webreview-dev --blueprint=./wordpress-plugin/dev/blueprint.json --define WP_ENVIRONMENT_TYPE local --login",
    "wp:zip": "mkdir -p build && rm -f build/webreview-connector.zip && cd wordpress-plugin && zip -rq ../build/webreview-connector.zip webreview-connector -x '*.DS_Store'"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.0",
    "firebase-admin": "^13.10.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "puppeteer-core": "^25.14.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
