# GEMINI_API_KEY: Required for Gemini AI API calls (Fix with AI, AI review, pin actions).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The address where Vpin is hosted.
# Used for links back to the app (emails, notifications) and sign-in callbacks.
APP_URL="MY_APP_URL"

# Supabase (Project Settings → API in the Supabase dashboard)
# Project URL and the public anon / publishable key: used by the browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Service-role / secret key: server only. Never prefix it with VITE_ (that would send it to browsers).
SUPABASE_SERVICE_ROLE_KEY=

# Email to the team (e.g. when a client submits a revision). Leave SMTP_HOST empty to send no email.
# Google Workspace: smtp.gmail.com, port 465, the sending account and its App Password (or Google's smtp-relay).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown on the emails, e.g. "Vpin <notifications@yourdigitalagents.com>" (default: SMTP_USER)
MAIL_FROM=

# Master admin accounts (comma-separated). These emails are always Owner.
VITE_ADMIN_EMAILS=
