// Vpin on Cloudflare: the Worker (worker/index.ts) serves the pages and passes /api/... to the server container.
// Deployed by .github/workflows/deploy.yml on every push to main. Secrets are set once with `npx wrangler secret put`
// (see README.md, "Hosting on Cloudflare"); they are never kept here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "v-pin",
  "account_id": "922151a6769341fd4ee7ee7caa246fb1",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "containers": [
    {
      "class_name": "VpinServer",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SERVER", "class_name": "VpinServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VpinServer"] }],
  // Wakes the server every 5 minutes for reminders and the daily summary
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "APP_URL": "https://v-pin.pid-brdl-technical.workers.dev",
    "R2_ACCOUNT_ID": "922151a6769341fd4ee7ee7caa246fb1",
    "R2_BUCKET": "vpin-uploads",
    "SMTP_PORT": "465"
  }
}
